{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",

    "baseUrl": ".",
    "paths": {
      "@utils/*": ["utils/*"],
      "@UiFolder/*": ["testsfolders/UiTestsFolder/*"],
      "@ApiFolder/*": ["tests/ApiTestsFolder/*"]
    },

    "types": ["node", "@playwright/test"],

    "resolveJsonModule": true,
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,

    "allowJs": true, // Remain for now, but will be removed if all files are converted to TypeScript
    "checkJs": false,

    "outDir": "dist"
  },
  "include": ["**/*.ts", "**/*.js", "**/*.json"]
}
